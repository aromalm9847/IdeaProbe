# ============================================================
# IdeaProbe Frontend — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# Backend API Base URL
# For local development: http://localhost:8000
# For production: your Railway backend URL
# Note: In local dev, Vite proxies /api to localhost:8000 automatically
VITE_API_BASE_URL=http://localhost:8000

# Google OAuth Web Client ID (optional — enables "Continue with Google")
# Get it at: https://console.cloud.google.com → APIs & Services → Credentials
# Use the WEB application client ID. Add http://localhost:5173 and your prod
# URL to "Authorized JavaScript origins" in Google Cloud.
VITE_GOOGLE_CLIENT_ID=
