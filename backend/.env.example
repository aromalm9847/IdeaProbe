# ============================================================
# IdeaProbe Backend — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# OpenAI API Key (REQUIRED)
# Get your key at: https://platform.openai.com/api-keys
# GPT-4.1 access is required for the 4-agent pipeline
IDEAPROBE_OPENAI_KEY=sk-proj-YOUR_OPENAI_API_KEY_HERE

# AI Model (optional)
# Default: gpt-4.1 (fast, accurate, cost-effective)
# Alternatives: gpt-4o, gpt-4.1-mini (cheaper but less accurate)
# IDEAPROBE_MODEL=gpt-4.1

# Generate a strong key: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=ideaprobe-super-secret-jwt-key-change-in-production-2025

# Database (optional)
# Default: SQLite file in the backend/ directory (no setup needed)
# For PostgreSQL: postgresql+asyncpg://user:password@host:5432/dbname
# DATABASE_URL=sqlite+aiosqlite:///./ideaprobe.db

# Reddit API (optional)
# Improves signal quality with real Reddit data
# Without these, the app uses simulated Reddit data
# Get keys at: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=IdeaProbe/1.0

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
